FROM ros:jazzy-ros-base-noble AS ros-base

SHELL ["/bin/bash", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ros-jazzy-example-interfaces \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

FROM ros-base AS simulator
COPY simulator.py /app/simulator.py
CMD ["python3.12", "/app/simulator.py"]

FROM ros-base AS bridge
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv --system-site-packages /opt/bridge-venv

RUN /opt/bridge-venv/bin/pip install --no-cache-dir \
    "confluent-kafka==2.6.1"

COPY consumer.py /app/consumer.py

CMD ["bash", "-lc", "source /opt/ros/jazzy/setup.bash && exec /opt/bridge-venv/bin/python /app/consumer.py"]
