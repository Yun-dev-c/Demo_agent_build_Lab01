{
  "uid": "robotics-fleet",
  "title": "Robotics Fleet Operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Receipt processing rate",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "sum(rate(robotics_receipts_processed_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Receipt outcomes · last 5 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "sum by (outcome) (increase(robotics_receipts_processed_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Receipt failures · last 5 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "sum by (reason) (increase(robotics_receipts_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Receipt processing P95",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(robotics_receipt_processing_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer last-success age",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "time() - (robotics_consumer_last_success_timestamp_seconds > 0)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Receipt group lag",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"robotics-fleet-receipts\",topic=\"robot.events\"} >= 0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "API metrics scrape availability",
      "description": "1 means Prometheus successfully scraped /metrics. Readiness is available separately at /health/ready.",
      "datasource": {
        "type": "prometheus",
        "uid": "robotics-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "robotics-prometheus"
          },
          "expr": "up{job=\"robotics-api\"}"
        }
      ]
    }
  ]
}
